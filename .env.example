# Alamat database SQLite lokal (bawaan).
# Format: file:./dev.db  (berkas di root proyek)
DATABASE_URL="file:./dev.db"
# Untuk deploy dengan volume persisten (mis. Coolify, lihat README bagian
# "Deploy di Coolify"), arahkan ke berkas di dalam volume itu, misalnya:
# DATABASE_URL="file:/data/dev.db"
# Kode sudah membuat folder induknya otomatis kalau belum ada, jadi path
# volume apa pun langsung jalan — asalkan volume-nya sudah dipasang.
# Untuk Postgres yang di-hosting nanti, ganti lapisan lib/db.ts dengan
# driver Postgres dan isi DATABASE_URL dengan alamat Postgres di sini.

# Pembayaran Midtrans (Tahap 2). Kunci HANYA lewat environment variable —
# tidak pernah ditulis di repo, di berkas ini yang ter-commit, atau di chat.
# Ambil dari dasbor Midtrans (Settings > Access Keys): mulai dari Sandbox
# dulu, ganti ke kunci Production setelah uji Sandbox lolos.
MIDTRANS_SERVER_KEY=""
# Client Key dipakai kalau nanti ada Snap popup; alur sekarang memakai
# Snap Redirect (halaman bayar Midtrans), jadi Client Key belum dipakai
# kode, tapi tetap dipasang untuk kebutuhan ke depan.
MIDTRANS_CLIENT_KEY=""
# "false" = Sandbox (app.sandbox.midtrans.com), "true" = Production.
# Jangan set "true" sebelum uji Sandbox lolos dan akun Production aktif.
MIDTRANS_IS_PRODUCTION="false"
# Opsional, HANYA untuk pengujian lokal dengan mock server Snap.
# Di Coolify/produksi biarkan kosong (default Sandbox/Production dipakai).
# MIDTRANS_SNAP_BASE_URL="http://localhost:3199"

# Folder foto unggahan (Tahap 4). Kosong = public/unggahan (lokal).
# Di Coolify, image mengatur UNGGAHAN_DIR=/data/unggahan supaya foto
# tidak hilang saat redeploy (volume /data sudah dipasang untuk database).
# UNGGAHAN_DIR="/data/unggahan"

# Cadangan database SQLite (Tahap 4, skrip scripts/cadangkan-db.mjs).
# Kosong = /data/cadangan kalau database di /data, atau ./cadangan.
# CADANGAN_DIR="/data/cadangan"
# Jumlah cadangan terbaru yang dipertahankan (default 7).
# CADANGAN_RETENSI="7"

# Garam hash IP untuk batas kirim RSVP (Tahap 4). Pasang string acak
# panjang di produksi supaya hash IP tidak bisa dibalik dengan brute
# force; tanpa garam pun IP mentah tidak pernah disimpan, hanya hashnya.
# RSVP_IP_SALT="isi-string-acak-panjang-di-sini"

# Alamat publik situs (Tahap 5, SEO): dipakai metadataBase, sitemap,
# robots, dan pratinjau Open Graph. Kosong = https://inv.benifin.my.id.
# SITUS_URL="https://inv.benifin.my.id"

# Kontak dukungan (Tahap 5, halaman Bantuan). Pasang salah satu atau
# keduanya di Coolify sebelum pengumuman — kalau keduanya kosong,
# halaman Bantuan menampilkan pemberitahuan bahwa kontak belum
# diumumkan (dan itu memblokir pengumuman di DAFTAR-PELUNCURAN.md).
# DUKUNGAN_EMAIL="dukungan@contoh.id"
# DUKUNGAN_WHATSAPP_URL="https://wa.me/6280000000000"
