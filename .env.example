# Alamat database SQLite lokal (bawaan).
# Format: file:./dev.db  (berkas di root proyek)
DATABASE_URL="file:./dev.db"
# Untuk deploy dengan volume persisten (mis. Coolify, lihat README bagian
# "Deploy di Coolify"), arahkan ke berkas di dalam volume itu, misalnya:
# DATABASE_URL="file:/data/dev.db"
# Kode sudah membuat folder induknya otomatis kalau belum ada, jadi path
# volume apa pun langsung jalan — asalkan volume-nya sudah dipasang.
# Untuk Postgres yang di-hosting nanti, ganti lapisan lib/db.ts dengan
# driver Postgres dan isi DATABASE_URL dengan alamat Postgres di sini.
